{
  "name": "mmdb-schema-and-tools",
  "version": "0.1.0",
  "description": "JSON schemas, validation tools, and documentation for MMDB",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mmdb-validate": "./dist/validate-repo.js",
    "mmdb-build-indexes": "./dist/build-indexes.js",
    "mmdb-create-year-repo": "./dist/create-year-repo.js"
  },
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "validate": "node dist/validate-repo.js",
    "build-indexes": "node dist/build-indexes.js",
    "create-year-repo": "node dist/create-year-repo.js",
    "ingest": "node dist/ingest-from-wikidata.js",
    "ingest-people": "node dist/ingest-people.js",
    "test": "npm run build:test && node --test dist/test/*.test.js"
  },
  "keywords": ["mmdb", "media", "database", "metadata"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "@octokit/rest": "^20.0.0"
  }
}
