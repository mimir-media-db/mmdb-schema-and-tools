{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mmdb.org/schema/movie-v1.json",
  "title": "Movie",
  "description": "A standalone film, documentary, or short",
  "type": "object",
  "required": ["schema_version", "id", "title", "year", "type"],
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^m_[a-z0-9_]+_[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "original_title": {
      "type": "string"
    },
    "year": {
      "type": "number",
      "minimum": 1800,
      "maximum": 2100
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": ["movie", "documentary", "short"]
    },
    "runtime_minutes": {
      "type": "number",
      "minimum": 1
    },
    "original_language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "summary": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "directors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^p_[a-z0-9_]+$"
      }
    },
    "writers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^p_[a-z0-9_]+$"
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^p_[a-z0-9_]+$"
      }
    },
    "external_ids": {
      "type": "object",
      "properties": {
        "wikidata": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "imdb": {
          "type": "string",
          "pattern": "^tt[0-9]+$"
        },
        "tmdb": {
          "type": "number"
        }
      }
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  }
}
