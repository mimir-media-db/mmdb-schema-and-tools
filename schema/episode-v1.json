{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mmdb.org/schema/episode-v1.json",
  "title": "Episode",
  "description": "A single episode of a series",
  "type": "object",
  "required": ["schema_version", "id", "series_id", "season_id", "season_number", "episode_number"],
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^e_[a-z0-9_]+_s[0-9]{2}e[0-9]{2}$"
    },
    "series_id": {
      "type": "string",
      "pattern": "^s_[a-z0-9_]+$"
    },
    "season_id": {
      "type": "string",
      "pattern": "^s_[a-z0-9_]+_season_[0-9]{2}$"
    },
    "season_number": {
      "type": "number",
      "minimum": 1
    },
    "episode_number": {
      "type": "number",
      "minimum": 1
    },
    "absolute_number": {
      "type": "number",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "air_date": {
      "type": "string",
      "format": "date"
    },
    "runtime_minutes": {
      "type": "number",
      "minimum": 1
    },
    "summary": {
      "type": "string"
    },
    "directors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^p_[a-z0-9_]+$"
      }
    },
    "writers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^p_[a-z0-9_]+$"
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^p_[a-z0-9_]+$"
      }
    },
    "external_ids": {
      "type": "object",
      "properties": {
        "wikidata": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "imdb": {
          "type": "string",
          "pattern": "^tt[0-9]+$"
        },
        "tmdb": {
          "type": "number"
        }
      }
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  }
}
