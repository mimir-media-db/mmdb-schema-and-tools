{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mmdb.org/schema/season-v1.json",
  "title": "Season",
  "description": "A subdivision of a series",
  "type": "object",
  "required": ["schema_version", "id", "series_id", "season_number"],
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^s_[a-z0-9_]+_season_[0-9]{2}$"
    },
    "series_id": {
      "type": "string",
      "pattern": "^s_[a-z0-9_]+$"
    },
    "season_number": {
      "type": "number",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "year": {
      "type": "number",
      "minimum": 1800,
      "maximum": 2100
    },
    "first_air_date": {
      "type": "string",
      "format": "date"
    },
    "last_air_date": {
      "type": "string",
      "format": "date"
    },
    "episode_count": {
      "type": "number",
      "minimum": 1
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  }
}
