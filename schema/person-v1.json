{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mmdb.org/schema/person-v1.json",
  "title": "Person",
  "description": "An individual (actor, director, writer, etc.)",
  "type": "object",
  "required": ["schema_version", "id", "name"],
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^p_[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "birth_year": {
      "type": "number",
      "minimum": 1800,
      "maximum": 2100
    },
    "death_year": {
      "type": ["number", "null"],
      "minimum": 1800,
      "maximum": 2100
    },
    "also_known_as": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_ids": {
      "type": "object",
      "properties": {
        "wikidata": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "imdb": {
          "type": "string",
          "pattern": "^nm[0-9]+$"
        },
        "tmdb": {
          "type": "number"
        }
      }
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    }
  }
}
