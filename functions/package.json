{
  "name": "mmdb-ingestion-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for automated MMDB Wikidata ingestion",
  "main": "dist/index.js",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "yarn run build && firebase emulators:start --only functions",
    "shell": "yarn run build && firebase functions:shell",
    "start": "yarn run shell",
    "deploy": "yarn build && firebase deploy --only functions",
    "ingest:local": "yarn build && node --env-file=.env dist/local-runner.js",
    "ingest:local:live": "yarn build && node --env-file=.env dist/local-runner.js --live",
    "ingest:dry": "node scripts/ingest-dry.mjs",
    "ingest:now": "node scripts/ingest-now.mjs",
    "ingest:current-year:dry": "node scripts/ingest-current-year.mjs --dry",
    "ingest:current-year:now": "node scripts/ingest-current-year.mjs",
    "logs": "firebase functions:log",
    "setup:repos": "node scripts/setup-repos.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --env-file=.env.test --test dist/test/**/*.test.js",
    "test:build": "tsc -p tsconfig.test.json && yarn test"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^20.0.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "private": true
}
