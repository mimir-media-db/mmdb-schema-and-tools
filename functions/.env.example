# GitHub App authentication (production)
# Create at: https://github.com/organizations/mimir-media-db/settings/apps/new
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# PAT fallback (local development)
# Only needed if GitHub App vars are not set
GITHUB_TOKEN=your-github-pat-here

# Ingestion settings
INGEST_API_KEY=your-random-secret-here
FUNCTION_URL=https://us-central1-your-project.cloudfunctions.net/mmdbIngestManual
MMDB_DRY_RUN=false
